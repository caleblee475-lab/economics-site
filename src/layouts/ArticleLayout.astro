---
const { frontmatter } = Astro.props;
// Ensure base has no trailing slash
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pubDate = new Date(frontmatter.pubDate);
const formattedDate = pubDate.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
});

// Cleanly construct the path
// If coverImage starts with '/', join base + path. If not, add a slash.
const heroImagePath = frontmatter.coverImage.startsWith('/') 
  ? `${base}${frontmatter.coverImage}` 
  : `${base}/${frontmatter.coverImage}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      body { 
        font-family: 'Inter', sans-serif;
        background-color: #0B192C;
        color: #F8FAFC;
        margin: 0; 
        padding: 0; 
      }
      
      .paper-container {
        max-width: 768px; 
        margin: 0 auto; 
        background-color: #112240;
        box-shadow: 0 0 20px rgba(0,0,0,0.5);
        color: #F8FAFC;
        min-height: 100vh;
      }

      .nav-bar { 
        text-align: center; 
        padding: 2rem 0 1rem 0;
        font-family: 'Inter', sans-serif;
        font-weight: bold; 
      }
      .nav-bar a { color: #F8FAFC; text-decoration: none; margin: 0 10px; }
      .nav-bar a:hover { color: #64FFDA; text-decoration: underline; }

      .hero-section {
        position: relative;
        height: 50vh; 
        display: flex;
        flex-direction: column;
        justify-content: flex-end; 
        padding: 2rem;
        background-size: cover;
        background-position: center;
        border-top: 2px solid #233554;
        border-bottom: 2px solid #233554;
      }
      
      .hero-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.85));
        z-index: 1;
      }

      .hero-text {
        position: relative;
        z-index: 2;
        color: #FFFFFF; 
      }
      
      .article-title {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        line-height: 1.2;
        font-family: 'Playfair Display', serif;
        color: #F8FAFC;
      }
      
      .article-meta {
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: 600;
        color: #A8B2D1;
        font-family: 'Inter', sans-serif;
      }

      .content {
        padding: 2rem; 
        line-height: 1.8; 
        font-size: 1.1rem;
      }
      
      .content blockquote {
        border-left: 4px solid #64FFDA;
        padding-left: 1rem;
        margin-left: 0;
        font-style: italic;
        color: #A8B2D1;
        background-color: #1A2E50;
        padding: 1rem;
      }

      .content h2 {
        font-family: 'Playfair Display', serif;
        color: #E2E8F0;
        border-bottom: 1px solid #233554;
        padding-bottom: 0.5rem;
      }

      .content img {
        border: 2px solid #233554;
        border-radius: 4px;
        max-width: 100%;
      }

      .site-footer {
        text-align: center;
        padding: 2rem 0;
        margin-top: 4rem;
        border-top: 1px solid #233554;
        font-size: 0.85rem;
        color: #A8B2D1;
        font-family: 'Inter', sans-serif;
      }
      .fade-in-up { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
      .fade-in-up.is-visible { opacity: 1; transform: translateY(0); }
    </style>
  </head>
  <body>
    <div class="paper-container">
      <div class="nav-bar">
        <a href={base}>Home</a> | 
        <a href={`${base}apac`}>APAC</a> | 
        <a href={`${base}europe`}>Europe</a>
      </div>

      <div class="hero-section" style={`background-image: url('${heroImagePath}');`}>
        <div class="hero-overlay"></div>
        <div class="hero-text">
          <h1 class="article-title">{frontmatter.title}</h1>
          <div class="article-meta">Uploaded &bull; {formattedDate}</div>
        </div>
      </div>

      <div class="content fade-in-up">
        <slot />
      </div>

      <footer class="site-footer">
        &copy; {new Date().getFullYear()} Economic Intelligence. All rights reserved.
      </footer>
    </div>
  </body>
  <script is:inline define:vars={{ base }}>
    // 'base' is dynamically injected from Astro's frontmatter during build time!
    document.querySelectorAll('.content img').forEach(img => {
      let src = img.getAttribute('src');
      
      // If the image starts with 'images/', prefix it with the correct dynamic base
      if (src && src.startsWith('images/')) {
        img.src = base + '/' + src;
      }
    });

    document.addEventListener("DOMContentLoaded", () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      const content = document.querySelector('.fade-in-up');
      if (content) {
        observer.observe(content);
      }
    });
  </script>
</html>