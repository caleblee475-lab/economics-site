---
// Define the structure of your data to fix the TypeScript errors
interface Frontmatter {
  title: string;
  pubDate: string;
  region: string;
  coverImage: string;
  summary: string;
}

interface Article {
  url: string;
  frontmatter: Frontmatter;
}

// Import articles and cast them to our Article type
const allArticles = Object.values(import.meta.glob('./*.md', { eager: true })) as Article[];
const base = import.meta.env.BASE_URL;

// Sort articles newest to oldest with explicit types for 'a' and 'b'
allArticles.sort((a: Article, b: Article) => Date.parse(b.frontmatter.pubDate) - Date.parse(a.frontmatter.pubDate));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Economic Intelligence</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Inter', sans-serif; background-color: #0B192C; color: #F8FAFC; max-width: 768px; margin: 0 auto; padding: 2rem; }
      h1 { font-family: 'Playfair Display', serif; color: #F8FAFC; text-align: center; border-bottom: 2px solid #233554; padding-bottom: 1rem; }
      .nav-bar { text-align: center; margin-bottom: 3rem; font-family: 'Inter', sans-serif; font-weight: bold; }
      .nav-bar a { color: #F8FAFC; text-decoration: none; margin: 0 10px; }
      .nav-bar a:hover { color: #64FFDA; text-decoration: underline; }
      .article-card { display: flex; align-items: center; background: #112240; padding: 1.5rem; border: 1px solid #233554; border-radius: 4px; margin-bottom: 1.5rem; text-decoration: none; color: #F8FAFC; }
      .article-card:hover { border-color: #64FFDA; box-shadow: 0 4px 20px rgba(0,0,0,0.25); transition: 0.2s ease-in-out; }
      .thumbnail { width: 120px; height: 120px; object-fit: cover; margin-right: 1.5rem; background-color: #233554; }
      .meta { font-size: 0.85rem; color: #A8B2D1; font-family: 'Inter', sans-serif; font-weight: bold; text-transform: uppercase; }
      .title { margin: 0.5rem 0; font-size: 1.4rem; font-family: 'Playfair Display', serif; color: #F8FAFC; }
      .fade-in-up { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
      .fade-in-up.is-visible { opacity: 1; transform: translateY(0); }
    </style>
  </head>
  <body>
    <h1>Economic Intelligence</h1>
    
    <div class="nav-bar">
      <a href={base}>Home</a> | 
      <a href={`${base}apac`}>APAC</a> | 
      <a href={`${base}europe`}>Europe</a>
    </div>

    <div>
      {allArticles.map((article: Article) => (
        /* Use article.url directly (Astro auto-prefixes the base) */
        <a href={article.url} class="article-card fade-in-up">
          {/* Manually add base to images */}
          <img 
            src={`${base}${article.frontmatter.coverImage.startsWith('/') ? article.frontmatter.coverImage.slice(1) : article.frontmatter.coverImage}`} 
            class="thumbnail" 
            alt="Cover Image" 
          />
          
          <div>
            <div class="meta">{article.frontmatter.region} • {article.frontmatter.pubDate}</div>
            <h2 class="title">{article.frontmatter.title}</h2>
            <div style="font-size: 1rem; color: #A8B2D1;">{article.frontmatter.summary}</div>
          </div>
        </a>
      ))}
    </div>
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.fade-in-up').forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>